# Endereço público do site. Sem isto, o card de compartilhamento do WhatsApp
# e o canonical apontam para o domínio do Workers.
NEXT_PUBLIC_SITE_URL=

# Painel da vitrine. Sem estas variaveis o site funciona normalmente,
# mas /admin fica indisponivel e a home usa a vitrine inicial do codigo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
